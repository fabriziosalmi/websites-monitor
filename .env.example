# Copy to .env next to docker-compose.yml. Every variable is optional:
# a check that needs a missing key returns no verdict and says which key.

# Where docker compose publishes the API and the web UI. The default only
# accepts connections from this machine; set the address of a network
# interface (or 0.0.0.0) to reach it from the network.
WM_BIND_ADDRESS=127.0.0.1
WM_PORT=8000

# Google PageSpeed Insights, for the pagespeed_performances check and the
# Lighthouse score of the accessibility check.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# GitHub token for the data_leakage check (GitHub code search needs one).
GITHUB_TOKEN=

# WAVE API key: the accessibility check uses WAVE when Lighthouse is not
# available. Without it, the check falls back to its own HTML heuristics.
WAVE_API_KEY=

# Seconds between two scheduler runs (3600 = one hour).
MONITOR_INTERVAL=3600

# Local runs only (python api.py): address, port, and auto reload on code
# changes. Never enable reload in production: it drops requests in flight.
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=1

# Where the domain blacklist is cached (107 MB). Default: the system temp
# directory, under websites-monitor/.
# WM_CACHE_DIR=
